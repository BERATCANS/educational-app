# ============================================
# Environment Variables Template
# ============================================
# Bu dosya bir template'tir. Gerçek değerleri .env dosyasına kopyalayın.
# .env dosyası Git'e commit edilmez (güvenlik için)

# ============================================
# Database Configuration
# ============================================
DB_URL=jdbc:postgresql://localhost:5432/soruapp
DB_USERNAME=berat
DB_PASSWORD=your_database_password

# ============================================
# OpenAI API Configuration
# ============================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=120

# ============================================
# JWT Configuration
# ============================================
# Production'da mutlaka güçlü bir secret key kullanın (min 32 karakter)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long

# ============================================
# Email Configuration (Hostinger)
# ============================================
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USERNAME=your_email@example.com
EMAIL_PASSWORD=your_email_password

# ============================================
# Application Configuration
# ============================================
APP_BASE_URL=http://localhost:8080
APP_EMAIL_FROM=your_email@example.com

# ============================================
# CORS Configuration
# ============================================
# Production'da sadece production URL'lerini ekleyin
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173
